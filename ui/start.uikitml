<style>
  .panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 54;
    padding: 3;
    background-color: #fff4e0;
    border-color: #e8322e;
    border-width: 0.3;
    border-radius: 2.5;
  }
  .title {
    font-size: 4.6;
    font-weight: bold;
    letter-spacing: 1;
