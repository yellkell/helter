<style>
  .wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 60;
    padding: 1;
  }
  /* A solid banner, not bare text: the warning used to be cream letters on
     open sky, which vanished over the sea and the pale green downs. */
  #warn-text {
    font-size: 6;
    font-weight: bold;
    letter-spacing: 1.2;
    color: #fff4e0;
    background-color: #e8322e;
    border-color: #fff4e0;
    border-width: 0.35;
    border-radius: 1.6;
    padding-top: 1.1;
    padding-bottom: 1.1;
    padding-left: 3.5;
    padding-right: 3.5;
    text-align: center;
  }
</style>
<div class="wrap">
  <span id="warn-text">HOLD ON</span>
</div>
