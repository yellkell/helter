<style>
  /* Every box in the HUD has a fixed size, so no readout ever wraps, shifts
     its neighbours, or resizes the panel as its digits change. The panel
     is 48 wide with 2 padding: 44 inside. */
  .hud {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 48;
    padding: 2;
    background-color: #fff4e0;
    border-color: #e8322e;
    border-width: 0.22;
    border-radius: 2;
  }
  .row {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
    height: 3;
  }
  #tier-label {
    font-size: 2;
    font-weight: bold;
    letter-spacing: 0.35;
    color: #e8322e;
    width: 15;
    flex-shrink: 0;
    text-align: left;
    word-break: keep-all;
  }
  #coin-label {
    font-size: 2;
    font-weight: bold;
    letter-spacing: 0.35;
    color: #b58f1f;
    width: 14;
    flex-shrink: 0;
    text-align: center;
    word-break: keep-all;
  }
  #alt-label {
    font-size: 2;
    font-weight: bold;
    letter-spacing: 0.35;
    color: #1e6f9e;
    width: 15;
    flex-shrink: 0;
    text-align: right;
    word-break: keep-all;
  }
  /* The big readout: a right-aligned number box and a left-aligned unit box
     meeting at the centre, so "58" and "KM/H" both stay put while the
     number races up from 0 on launch. During the countdown the unit box is
     blank and the count sits in the number box. */
  .speed {
    display: flex;
    flex-direction: row;
    align-items: flex-end;
    justify-content: center;
    width: 100%;
    height: 9;
    margin-top: 0.4;
  }
  #big-label {
    font-size: 7;
    font-weight: bold;
    color: #1a1614;
    width: 21;
    height: 9;
    flex-shrink: 0;
    text-align: right;
    vertical-align: bottom;
    word-break: keep-all;
  }
  #unit-label {
    font-size: 2.6;
    font-weight: bold;
    letter-spacing: 0.3;
    color: #1a1614;
    width: 19;
    height: 9;
    margin-left: 1.2;
    padding-bottom: 1.5;
    flex-shrink: 0;
    text-align: left;
    vertical-align: bottom;
    word-break: keep-all;
  }
  #status-label {
    font-size: 2;
    font-weight: bold;
    letter-spacing: 0.35;
    color: #b58f1f;
    width: 100%;
    height: 3.2;
    margin-top: 0.2;
    text-align: center;
    word-break: keep-all;
  }
</style>
<div class="hud">
  <div class="row">
    <span id="tier-label">TIER 1/3</span>
    <span id="coin-label">COINS 0</span>
    <span id="alt-label">ALT 300M</span>
  </div>
  <div class="speed">
    <span id="big-label">3</span>
    <span id="unit-label">SEC</span>
  </div>
  <span id="status-label">GRAB THE RAIL</span>
</div>
