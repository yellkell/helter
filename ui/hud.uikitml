<style>
  .hud {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 48;
    padding: 2;
    background-color: #fff4e0;
    border-color: #e8322e;
    border-width: 0.22;
    border-radius: 2;
  }
  .row {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
  }
  /* Fixed widths + flex-shrink 0 so the alt readout changing digit count
     never wraps to a second line or nudges the layout. */
  #tier-label {
    font-size: 2.2;
    font-weight: bold;
    letter-spacing: 0.5;
    color: #e8322e;
    width: 20;
    flex-shrink: 0;
    text-align: left;
  }
  #alt-label {
    font-size: 2.2;
    font-weight: bold;
    letter-spacing: 0.5;
    color: #1e6f9e;
    width: 22;
    flex-shrink: 0;
    text-align: right;
  }
  #big-label {
    font-size: 7;
    font-weight: bold;
    color: #1a1614;
    margin-top: 0.6;
  }
  #status-label {
    font-size: 2.1;
    font-weight: bold;
    letter-spacing: 0.7;
    color: #b58f1f;
    margin-top: 0.4;
  }
</style>
<div class="hud">
  <div class="row">
    <span id="tier-label">TIER 1/3</span>
    <span id="alt-label">ALT 300M</span>
  </div>
  <span id="big-label">3</span>
  <span id="status-label"> </span>
</div>
